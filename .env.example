# TODOKU_OPEN=0
# TODOKU_RATE_LIMIT=20
# TODOKU_RATE_LIMIT_ALL=60
# TODOKU_STEP_LIMIT=300
# TODOKU_DAILY_USD=30
# TODOKU_MACHINES=1
# TODOKU_MODEL=claude-opus-5-5
# TODOKU_EFFORT=low
