# とどくの環境変数の見本（値は入れない。実際の値はリポジトリの外のファイルか、置き場の secret で渡す）
# 意味と既定は README の「動かし方」の表を見てください。空のままの行は使わない。
ANTHROPIC_API_KEY=
TODOKU_PASSPHRASE=
